# ===========================================================================
# 目标平台：rockchip armv8 —— HINLINK HT2
#
# 与 00-target.config（x86_64）是**二选一**的关系，由 scripts/04-config.sh
# 按 $TARGET 决定拼哪一个。两个文件同时生效会让 kconfig 拿到两个
# CONFIG_TARGET_<board>=y，那是没有意义的组合。
#
# 设备层的支持（设备树 / U-Boot / board.d）不在这个文件里，而在
# overlay/target/rockchip-armv8/，由 scripts/03-target.sh 铺进去。
# 分工：本文件决定「编什么」，那个目录决定「跑得起来」。
# ===========================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_ht2=y

# --- 出什么镜像 -------------------------------------------------------------
# rockchip 目标每台设备**只出一个** sysupgrade.img.gz，内容是一个 GPT：
#   part1 boot  （kernel.img + boot.scr）   大小 = CONFIG_TARGET_KERNEL_PARTSIZE
#   part2 rootfs（rootfs）                  大小 = CONFIG_TARGET_ROOTFS_PARTSIZE
#   part0 前的 32768 扇区留空，放 u-boot-rockchip.bin（idbloader + u-boot）
#
# 所以 x86 那套 GRUB / ISO / TARGZ 的开关在这里一个都不适用，也不用写。
# 镜像的拼装规则在 target/linux/rockchip/image/Makefile 的
#     IMAGE/sysupgrade.img.gz = boot-common | boot-script | pine64-img | ...
CONFIG_TARGET_IMAGES_GZIP=y

# boot 分区：kernel.img 是 lzma 压缩过的 FIT，加上 boot.scr，
# rockchip 上游默认的 16MB 有富余。
CONFIG_TARGET_KERNEL_PARTSIZE=16

# --- 内存与裁剪 -------------------------------------------------------------
# HT2 是 1/2/4GB LPDDR4，装完后不管哪个档位都够用；
# 这里不写死任何按内存裁剪的开关，保持与 x86 一致的包集。

# --- 无线 ---------------------------------------------------------------
# HT2 的 SDIO 无线的两个可能批次（Broadcom BCM43752 / AICSemi AIC8800）
# 都由设备定义里的 DEVICE_PACKAGES 带进来，见
# overlay/target/rockchip-armv8/image/armv8.devices.mk。
# 这里不重复声明，避免两处清单各说各话。
