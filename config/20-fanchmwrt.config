# ===========================================================================
# FanchmWrt 特性层 —— 只有勾选了「包含 FanchmWrt 特性」才会并进来
#
# 并入的东西全部来自 vendor/fanchmwrt/，构建时被拷进 ImmortalWrt 树的
# package/fcm 与 package/fanchmwrt-packages 两个目录：
#
#   fwx            内核态 netfilter 模块，按应用特征识别流量（DPI）
#   fwxd           用户态守护进程，管特征库、会话与统计
#   libfwx_common  fwx 的公共库
#   kmod-nft-fullcone  fullcone NAT（nftables 版）
#   luci-theme-fanchmwrt  主题：仪表盘 + 菜单 + 高级/普通模式开关
#   luci-app-fwx-*        17 个 LuCI 应用
#
# 主题是这个层的关键：你要求的「仪表盘」和「高级/普通模式」不是独立包，
# 而是实现在 luci-theme-fanchmwrt 的菜单脚本里。所以勾了 FanchmWrt 就一定是
# FanchmWrt 主题，换主题等于整套界面都换掉 —— 这一点与需求是自洽的。
# ===========================================================================

# --- 内核模块与守护进程 -----------------------------------------------------
CONFIG_PACKAGE_kmod-fwx=y
CONFIG_PACKAGE_fwxd=y
CONFIG_PACKAGE_libfwx_common=y

# 关于 fullcone NAT：**这里什么都不用做。**
#
# fanchmwrt 的源码里带了 fullconenat 与 fullconenat-nft 两个包，那是为了补
# 上游 OpenWrt 没有这个功能的缺口。但 ImmortalWrt 树内
# package/network/utils/ 下**已经有**这两份（fullconenat-nft 与 fanchmwrt 的
# 逐字节相同），而且 firewall4 的 DEPENDS 里就挂着 +kmod-nft-fullcone ——
# 也就是说，只要装了防火墙，fullcone 的内核模块本来就在。
#
# 所以本层不收录这两个包（vendor/ 里也已删掉），也不在这里选它，
# 由 config/10-base.config 统一声明。两份同名包同时存在会让构建报重复包。

# --- 主题（仪表盘 + 高级/普通模式都在这里）----------------------------------
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# --- 17 个 luci-app-fwx-* ---------------------------------------------------
# 这些是旧式 Lua 应用，依赖 luci-compat（luci-compat 本身由底座层的
# luci-app-openclash / diskman / nfs 拖着，任何组合下都在）。
CONFIG_PACKAGE_luci-app-fwx-dashboard=y
CONFIG_PACKAGE_luci-app-fwx-dashboard-setting=y
CONFIG_PACKAGE_luci-app-fwx-app-center=y
CONFIG_PACKAGE_luci-app-fwx-appfilter=y
CONFIG_PACKAGE_luci-app-fwx-feature=y
CONFIG_PACKAGE_luci-app-fwx-macfilter=y
CONFIG_PACKAGE_luci-app-fwx-mac-blacklist=y
CONFIG_PACKAGE_luci-app-fwx-network=y
CONFIG_PACKAGE_luci-app-fwx-wireless=y
CONFIG_PACKAGE_luci-app-fwx-record=y
CONFIG_PACKAGE_luci-app-fwx-record-whitelist=y
CONFIG_PACKAGE_luci-app-fwx-resources=y
CONFIG_PACKAGE_luci-app-fwx-session-stat=y
CONFIG_PACKAGE_luci-app-fwx-system=y
CONFIG_PACKAGE_luci-app-fwx-traffic-stat=y
CONFIG_PACKAGE_luci-app-fwx-user=y
CONFIG_PACKAGE_luci-app-fwx-user-record=y
