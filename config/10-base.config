# ===========================================================================
# 底座层 —— 无论怎么勾选都会编进去
#
# 这一层就是你在需求里写的「默认」：
#   去掉 ddns / hd-idle / wol / smb 界面
#   加入 mosdns / openclash / ttyd
# 另外加了一套轻 NAS 套件（你确认过：归底座，不算 iStoreOS 特性）。
#
# 所有同名包都取自 ImmortalWrt 自带 feed，只有两个例外，原因写在各段注释里。
# ===========================================================================

# --- DNS 分流：mosdns -------------------------------------------------------
# 二进制用 ImmortalWrt 自带的 net/mosdns（5.3.3），界面用 sbwml 的
# luci-app-mosdns（1.7.14）。两边都提供名为 mosdns 的包，会在 feeds 阶段
# 撞名，所以 scripts/02-feeds.sh 删掉了 sbwml 那份 mosdns 目录，只留界面。
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

# v2ray-geodata 是**源包名，不是包名** —— 它构建出 v2ray-geoip /
# v2ray-geosite / v2ray-geosite-ir 三个子包，没有叫 v2ray-geodata 的包。
# luci-app-mosdns 的 LUCI_DEPENDS 里是 +v2ray-geoip +v2ray-geosite，
# 所以这里选这两个。（写源包名的后果是断言直接报「该有却没有」，
# 而不是悄悄编出一个没有规则数据的固件 —— 这正是断言存在的意义。）
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# --- 代理：OpenClash --------------------------------------------------------
# ImmortalWrt 的 luci 源**自带** luci-app-openclash，不需要 vernesong 的
# 第三方 feed —— 少一个外部依赖，也少一处可能腐烂的地方。
# 按你的选择：只装界面，mihomo 内核首次进网页时再下（见 README）。
CONFIG_PACKAGE_luci-app-openclash=y

# --- Web 终端 ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# --- 轻 NAS 套件 ------------------------------------------------------------
# 磁盘管理、NFS、多盘合并、SMB/WebDAV 统一共享、Windows 网络邻居发现。
# wsdd2 在本层是**故意的**：去掉的只是 Samba 的 LuCI 配置界面，
# 服务端与共享能力保留（见下面「明确不要的」一段）。
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_luci-app-mergerfs=y
CONFIG_PACKAGE_mergerfs=y
CONFIG_PACKAGE_luci-app-unishare=y
CONFIG_PACKAGE_unishare=y
CONFIG_PACKAGE_webdav2=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_xz-utils=y

# --- 本项目自己的包 ---------------------------------------------------------
# 承载构建时选定的管理地址，并往固件里留一份 /etc/build-options。
# 它必须永远在：管理地址跟 Docker、跟勾没勾谁都没有关系。
CONFIG_PACKAGE_build-defaults=y

# --- 底座的隐性依赖，显式写出来 ---------------------------------------------
# 这两个不是我们「加」的，而是底座本来就会带上，写在这里是为了让断言有意义 ——
# 断言只认 .config 里的字面值，不认「按理说应该有」。
#
#   kmod-nft-fullcone  firewall4 的 DEPENDS 里有 +kmod-nft-fullcone，
#                      而 firewall4 是 ImmortalWrt 的默认包。
#                      提供者：树内 package/network/utils/fullconenat-nft。
#                      （fanchmwrt 也带了一份同名的，已从 vendor/ 删掉。）
#   luci-compat        旧式 Lua 版 LuCI 应用的兼容层。底座层里的
#                      luci-app-openclash / luci-app-diskman / luci-app-nfs
#                      都依赖它，所以任何组合下都在。
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_luci-compat=y

# --- 明确不要的 -------------------------------------------------------------
# 语法说明：OpenWrt 用 `# CONFIG_PACKAGE_x is not set` 表示显式关闭。
# 光靠「不选」是不够的 —— 上游某个 feed 或某个 meta 包改天把它拖进来，
# 构建照样会过，只是固件里悄悄多出这些东西。写死 + scripts/04-config.sh
# 里的反向断言，才能保证「说了不要就真的没有」。
#
#   luci-app-ddns     DDNS 配置界面
#   luci-app-hd-idle  硬盘休眠界面
#   luci-app-wol      网络唤醒界面
#   luci-app-samba4   SMB **配置界面**（服务端 samba4-server 由 unishare
#                     依赖着留下，SMB 共享照常可用，只是没有网页入口）
#
# autosamba 是 ImmortalWrt 自己的「一键开 SMB」包，它 DEPENDS 于
# luci-app-samba4 + wsdd2，不关掉会把刚去掉的界面又拖回来。
#
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_autosamba is not set
