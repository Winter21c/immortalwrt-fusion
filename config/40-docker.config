# ===========================================================================
# Docker 层 —— 独立的复选框，与勾没勾 iStoreOS 无关
#
# ===========================================================================
# 这里**没有**对 dockerd 打任何补丁，这是核对过代码之后的决定
# ===========================================================================
#
# 原本打算照搬 iStoreOS 的 dockerd 定制：关掉 docker 自带的 iptables、
# 改由 fw4 统一管、再补一条 172.16.0.0/12 的出网 NAT。核对 ImmortalWrt
# 自带的 dockerd 之后放弃了这个方案，原因是：
#
#   1. **两边的做法是相反的。** ImmortalWrt 的 dockerd.init 自带
#      uciadd/ucidel，会创建 docker firewall zone、把接口加进去，
#      并且在 postinst 里自动调用（files/dockerd.init 第 85-100 行）。
#      它默认 iptables='1'，让 docker 自己管 NAT。
#      iStoreOS 那套是把 docker 的 iptables 关掉、全部搬到 fw4 ——
#      硬套上去等于把一套能用的机制拆掉换成另一套。
#
#   2. 版本对不上。ImmortalWrt 是 29.6.1，那份定制针对 27.3.1，
#      涉及的文件树都不一样，补丁根本打不上。
#
# 保留下来的是两件与 dockerd 版本无关、纯粹由 x86 镜像布局决定的事，
# 放在 vendor/istoreos/package/docker-defaults 里，不修改上游任何文件：
#
#   * squashfs 镜像上把 docker 数据目录指到 /overlay/upper，
#     否则 overlay2 存储驱动会因为 backing filesystem 是 overlay 而拒绝启动；
#   * 给容器日志封顶，否则一个话多的容器能把盘写满。
#
# ===========================================================================

CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y

# 运行时与工具：dockerd 自带 containerd/runc/tini 依赖，显式写出来是为了
# 让断言能发现「依赖链某天断了」这种情况。
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y

# 本项目自己的 docker 默认值包（数据目录落点 + 日志封顶）。
CONFIG_PACKAGE_docker-defaults=y
