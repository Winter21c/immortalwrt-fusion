# ===========================================================================
# 目标平台：x86_64 generic
#
# 本项目**只支持 x86**。原因见 README「为什么只有 x86」：
#   * fwx 内核模块、iStoreOS 的 quickstart 后端、Docker 三者的预编译产物
#     与依赖都只在 x86_64 / aarch64 上成立；
#   * 只覆盖一个目标，才能对每个组合都给出「编得过、验得过」的保证。
#
# make defconfig 会保留这里显式写死的项，并补上其余默认值。
# ===========================================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# --- 出哪些镜像 -------------------------------------------------------------
# 只出 4 个：squashfs / ext4 各含 efi 与非 efi。
#   * TARGZ 关掉：它同时控制 -targz-* 三个镜像和 rootfs.tar.gz；
#   * INITRAMFS / CPIOGZ 关掉：x86 上它们只是恢复用，日常刷机用不到；
#   * ISO 关掉：多一个 ISO 既拖慢构建，Release 页面也更乱。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set

# --- 引导 -------------------------------------------------------------------
# BIOS 与 UEFI 都出，用户拿不准时先试 efi 那个。
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# --- 分区 -------------------------------------------------------------------
# KERNEL_PARTSIZE 是 /boot 分区，16MB 对 x86 够用。
# ROOTFS_PARTSIZE 由 scripts/04-config.sh 按用户输入的固件大小覆盖，
# 这里不写死 —— 写死会让用户的选择失效。
CONFIG_TARGET_KERNEL_PARTSIZE=16
