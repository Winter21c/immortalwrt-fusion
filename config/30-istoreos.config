# ===========================================================================
# iStoreOS 特性层 —— 只有勾选了「包含 iStoreOS 特性」才会并进来
#
# 按你的确认，这一层只包含三样东西：
#
#   quickstart        首页快速设置面板（上网方式 / 网络状态 / Wi-Fi 一页搞定）
#   iStore 应用商店   图形化装插件，带教程与依赖解析
#   argon 主题        iStoreOS 的默认主题
#
# 轻 NAS 套件（NFS / mergerfs / unishare / WebDAV / wsdd2 / DiskMan）**不在**
# 这一层，它们归底座，无论勾不勾 iStoreOS 都在（见 config/10-base.config）。
#
# 主题来源：luci-theme-argon 直接用 ImmortalWrt 的 luci 源自带的版本。
# 原本可以用 jjm2473/openwrt-third，但那个 feed 与 ImmortalWrt 自带的
# luci-theme-argon / luci-app-nfs / luci-app-argon-config 全部重名，
# 一起装会撞包。用自带的更干净，也不引入额外 feed。
# ===========================================================================

# --- 首页面板 ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_quickstart=y

# --- iStore 应用商店 --------------------------------------------------------
# luci-app-store 依赖 taskd 与两个 luci-lib，这里全部显式写出来，
# 这样 scripts/04-config.sh 的断言能逐个核对，而不是只看顶层那一个。
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y

# --- 主题 -------------------------------------------------------------------
# 勾了 FanchmWrt 时本项会被 scripts/04-config.sh 强制去掉，由
# luci-theme-fanchmwrt 接手；只勾 iStoreOS 时它就是唯一的主题。
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
